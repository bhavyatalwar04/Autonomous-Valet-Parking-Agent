      geometry Box { size 4.5 1.9 1.3 }
    }
  ]
  boundingObject Box { size 4.5 1.9 1.3 }
}

Solid {
  translation 31.75 31.5 0.65
  name "parked_car_D9"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.65 0.22 0.16 roughness 0.85 }
      geometry Box { size 4.5 1.9 1.3 }
    }
  ]
  boundingObject Box { size 4.5 1.9 1.3 }
}


Robot {
  # Origin = centre of the rear axle, at wheel-radius height (0.3 m) so the
  # tyres touch the floor. FLU body frame: +x forward, +y left, +z up.
  translation 2 8.5 0.3
  rotation 0 0 1 0
  name "valet_car"
  controller "valet_controller"
  children [
    # ---- chassis (4.6 m long: 1.0 m rear overhang + 2.8 m wheelbase + 0.8 m front overhang)
    # Split into three boxes so the steered front wheels have room to turn.
    Transform {
      translation 0.6 0 0.05
      children [ Shape { appearance DEF CAR_BODY PBRAppearance { baseColor 0.12 0.38 0.72 roughness 0.35 } geometry Box { size 3.2 1.3 0.3 } } ]
    }
    Transform {
      translation 2.8 0 0.05
      children [ Shape { appearance USE CAR_BODY geometry Box { size 1.2 0.7 0.3 } } ]
    }
    Transform {
      translation 3.5 0 0.05
      children [ Shape { appearance USE CAR_BODY geometry Box { size 0.2 1.5 0.3 } } ]
    }
    # cabin: visual only and entirely above the lidar scan plane (z = 0.28 m)
    Transform {
      translation 1.2 0 0.54
      children [ Shape { appearance PBRAppearance { baseColor 0.55 0.75 0.9 roughness 0.2 } geometry Box { size 1.6 1.3 0.32 } } ]
    }

    # ---- sensors
    GPS { name "gps" }
    Compass { name "compass" }
    InertialUnit { name "imu" }
    # Lidar: FLU frame, so no rotation is needed for a horizontal scan.
    # Mounted below the cabin and above the chassis so it never sees the car.
    Transform {
      translation 0 0 0.23
      children [ Shape { appearance PBRAppearance { baseColor 0.1 0.1 0.1 roughness 0.6 } geometry Cylinder { height 0.06 radius 0.05 } } ]
    }
    Lidar {
      name "lidar"
      translation 0 0 0.28
      horizontalResolution 721
      fieldOfView 6.28318530718
      numberOfLayers 1
      near 0.05
      minRange 0.05
      maxRange 40
    }
    # Near-field distance sensors on the footprint edges (m, saturating at 5 m)
    DistanceSensor { name "ds_front" translation 3.62 0 0.05 type "laser" lookupTable [ 0 0 0, 5 5 0 ] }
    DistanceSensor { name "ds_rear" translation -1.02 0 0.05 rotation 0 0 1 3.14159265359 type "laser" lookupTable [ 0 0 0, 5 5 0 ] }
    DistanceSensor { name "ds_left" translation 0 0.96 0.05 rotation 0 0 1 1.57079632679 type "laser" lookupTable [ 0 0 0, 5 5 0 ] }
    DistanceSensor { name "ds_right" translation 0 -0.96 0.05 rotation 0 0 1 -1.57079632679 type "laser" lookupTable [ 0 0 0, 5 5 0 ] }

    # ---- rear axle: driven wheels, fixed direction
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 0.8 0 }
      device [
        RotationalMotor { name "rear_left_wheel_motor" maxVelocity 60 maxTorque 400 }
        PositionSensor { name "rear_left_wheel_sensor" }
      ]
      endPoint Solid {
        translation 0 0.8 0
        children [ DEF WHEEL Transform { rotation 1 0 0 1.5707963 children [ Shape { appearance DEF TYRE PBRAppearance { baseColor 0.08 0.08 0.08 roughness 0.9 } geometry Cylinder { height 0.25 radius 0.3 } } ] } ]
        name "rear_left_wheel"
        boundingObject Transform { rotation 1 0 0 1.5707963 children [ Cylinder { height 0.25 radius 0.3 } ] }
        physics Physics { density -1 mass 20 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 -0.8 0 }
      device [
        RotationalMotor { name "rear_right_wheel_motor" maxVelocity 60 maxTorque 400 }
        PositionSensor { name "rear_right_wheel_sensor" }
      ]
      endPoint Solid {
        translation 0 -0.8 0
        children [ USE WHEEL ]
        name "rear_right_wheel"
        boundingObject Transform { rotation 1 0 0 1.5707963 children [ Cylinder { height 0.25 radius 0.3 } ] }
        physics Physics { density -1 mass 20 }
      }
    }

    # ---- front axle (2.8 m ahead): steering joint (+z, positive = left), then wheel joint
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 0 1 anchor 2.8 0.8 0 }
      device [
        RotationalMotor { name "front_left_steer" minPosition -0.65 maxPosition 0.65 maxVelocity 3 maxTorque 2000 }
        PositionSensor { name "front_left_steer_sensor" }
      ]
      endPoint Solid {
        translation 2.8 0.8 0
        children [
          HingeJoint {
            jointParameters HingeJointParameters { axis 0 1 0 }
            device [
              RotationalMotor { name "front_left_wheel_motor" maxVelocity 60 maxTorque 400 }
              PositionSensor { name "front_left_wheel_sensor" }
            ]
            endPoint Solid {
              children [ USE WHEEL ]
              name "front_left_wheel"
              boundingObject Transform { rotation 1 0 0 1.5707963 children [ Cylinder { height 0.25 radius 0.3 } ] }
              physics Physics { density -1 mass 20 }
            }
          }
        ]
        name "front_left_knuckle"
        boundingObject Sphere { radius 0.05 }
        physics Physics { density -1 mass 3 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 0 1 anchor 2.8 -0.8 0 }
      device [
        RotationalMotor { name "front_right_steer" minPosition -0.65 maxPosition 0.65 maxVelocity 3 maxTorque 2000 }
        PositionSensor { name "front_right_steer_sensor" }
      ]
      endPoint Solid {
        translation 2.8 -0.8 0
        children [
          HingeJoint {
            jointParameters HingeJointParameters { axis 0 1 0 }
            device [
              RotationalMotor { name "front_right_wheel_motor" maxVelocity 60 maxTorque 400 }
              PositionSensor { name "front_right_wheel_sensor" }
            ]
            endPoint Solid {
              children [ USE WHEEL ]
              name "front_right_wheel"
              boundingObject Transform { rotation 1 0 0 1.5707963 children [ Cylinder { height 0.25 radius 0.3 } ] }
              physics Physics { density -1 mass 20 }
            }
          }
        ]
        name "front_right_knuckle"
        boundingObject Sphere { radius 0.05 }
        physics Physics { density -1 mass 3 }
      }
    }
  ]
  boundingObject Group {
    children [
      Transform { translation 0.6 0 0.05 children [ Box { size 3.2 1.3 0.3 } ] }
      Transform { translation 2.8 0 0.05 children [ Box { size 1.2 0.7 0.3 } ] }
      Transform { translation 3.5 0 0.05 children [ Box { size 0.2 1.5 0.3 } ] }
    ]
  }
  physics Physics { density -1 mass 1200 centerOfMass [ 1.2 0 -0.05 ] }
}
